# Build artifacts
*.o
*.d
*.i
*.elf
*.gba
*.bin
*.lz
*.map
stage1.o

# Compiler-generated .s intermediates: Make's %.o:%.c rule writes a .s next to
# every src/ .c, so refresh_expected.sh / a full `make` litters src/ with them.
# Ignore all .s under src/ EXCEPT the hand-written glue (crt0/exports/imports
# and the lib asm call_via/m4a0), which have no .c sibling and are tracked
# source-of-truth.
src/**/*.s
!src/**/crt0.s
!src/**/exports.s
!src/**/imports.s
!src/**/call_via.s
!src/**/m4a0.s
!src/**/agb_flash_data.s

# Raw per-function disassembly (asm/<path>/<Func>.s) is source-of-truth but
# force-added, so a genuinely new .s (e.g. a fresh split) must be staged with
# `git add -f`. This ignore keeps stray or leftover compiler intermediates
# from being tracked by accident; it does NOT untrack the committed
# disassembly (git never untracks tracked files).
asm/**/*.s

# Overlay data blobs (asm/maps/<tu>/<tu>_data.s) are hand-maintained source, not
# compiler output (which lands at asm/<rel>.s, never inside the per-TU dir), so
# they are tracked directly without a force-add.
!asm/**/*_data.s

# Per-machine expected disassembly cache
expected/

# decomp-permuter scratch (regenerated by import.py) + --debug artifacts
nonmatchings/
debug_source.c
debug_compiled_object.o

# User-installed toolchains (per INSTALL.md, installed via external git clone)
tools/gcc296/
tools/agbcc/
tools/gcc3/
tools/asm-differ/

# Python
__pycache__/
*.pyc

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
*:Zone.Identifier
*.bak

# Ctags artifacts
tags

# Dialog data extracted from baserom.gba by tools/unpack_strings + pack_strings (regenerated by make)
data/strings/

# m4a/Sappy
src/lib/m4a/m4a.s
